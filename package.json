{
  "name": "computer-use-automation-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "demo:app": "tsx src/cli.ts demo:app",
    "discover": "tsx src/cli.ts discover",
    "replay": "tsx src/cli.ts replay",
    "replay:handoff": "tsx src/cli.ts replay --headed --operator manual",
    "evidence:no-key": "tsx src/generate-evidence.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "check": "npm run format:check && npm run typecheck && npm run test"
  },
  "dependencies": {
    "express": "5.2.1",
    "openai": "7.4.0",
    "playwright": "1.62.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.13.3",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
