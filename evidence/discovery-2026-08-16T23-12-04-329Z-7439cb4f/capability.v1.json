    "entryRoutePattern": "^/backoffice/members/search$",
    "requiredLandmarks": [
      {
        "kind": "visible",
        "target": {
          "description": "member ID field",
          "robustnessNote": "Associated label is stable operator-facing language.",
          "candidates": [
            {
              "kind": "label",
              "text": "Member ID",
              "exact": true
